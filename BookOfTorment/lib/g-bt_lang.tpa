// v 3.1.4 polish

ACTION_IF (~%LANGUAGE%~ STR_EQ ~polish~) BEGIN
	COPY_EXISTING ~L_en_US.lua~ ~override/L_pl_PL.lua~
        PATCH_IF (INDEX_BUFFER(~G-Book of Torment~) < 0) BEGIN
            PATCH_FAIL ~Book of Torment POL: blok BoT nie został znaleziony w L_pl_PL.lua; wycofano zmiany, aby uniknąć częściowej lokalizacji.~
        END
        REPLACE_TEXTUALLY ~^[ %TAB%]*ORIGINAL_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    ORIGINAL_DBOX = "Ten suwak pozwala na zmianę okna dialogowego.^N\\n\\nO r i g i n a l e\\n^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*JPC_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    JPC_DBOX = "Ten suwak pozwala na zmianę okna dialogowego.^N\\n\\nJ o u r n a l \\tP o r t r a i t \\tC o n v e r s a t i o n s\\n\\t(à la Smeagolheart)^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SDB_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SDB_DBOX = "Ten suwak pozwala na zmianę okna dialogowego.^N\\n\\nB o c z n e \\tO k n o \\tD i a l o g o w e\\n^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*TTON_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    TTON_DBOX = "Ten suwak pozwala na zmianę okna dialogowego.^N\\n\\nA \\tl a \\tN u m e n e r a\\n^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*DBOX_SKIN[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    DBOX_SKIN = "Ten suwak pozwala na zmianę okna dialogowego.",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_0[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_0 = "^0xffd5c885Originale",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_1[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_1 = "^0xffd5c885z Portretami",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_2[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_2 = "^0xffd5c885Boczne",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_3[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_3 = "^0xffd5c885TTON",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*CLASSIC_INV[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    CLASSIC_INV = "Ten suwak pozwala na zmianę układu ekwipunku.^N\\n\\nK l a s y c z n y\\tE k w i p u n e k\\n^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SHARED_INV[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SHARED_INV = "Ten suwak pozwala na zmianę układu ekwipunku.^N\\n\\nW s p ó ł d z i e l o n y \\tE k w i p u n e k\\n^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*INV_SKIN[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    INV_SKIN = "Ten suwak pozwala na zmianę układu ekwipunku.",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_INV_STRING_0[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_INV_STRING_0 = "^0xff78b570Klasyczny",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_INV_STRING_1[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_INV_STRING_1 = "^0xff78b570Dzielony",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*DEFAULT_JOURNAL[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    DEFAULT_JOURNAL = "Ten suwak pozwala na zmianę okna dziennika.^N\\n\\nD o m y ś l n y\\tD z i e n n i k\\n^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*NEW_JOURNAL[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    NEW_JOURNAL = "Ten suwak pozwala na zmianę okna dziennika^N\\n\\nN o w y \\tD z i e n n i k\\n^-",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*JOURNAL_SKIN[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    JOURNAL_SKIN = "Ten suwak pozwala na zmianę okna dziennika",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_JOURNAL_0[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_JOURNAL_0 = "^0xff7f00ffDomyślny",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_JOURNAL_1[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_JOURNAL_1 = "^0xff7f00ffNowy",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*DIALOGUE_BOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    DIALOGUE_BOX = "Okno Dialogowe:",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*INVENTORY[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    INVENTORY = "Ukł. Ekwipunku:",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*JOURNAL[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    JOURNAL = "Ekran Dziennika:",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*COLOR_DESC[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    COLOR_DESC = "Koloruje i zapamiętuje wybrane odpowiedzi w dialogach (opcjonalne i eksperymentalne).",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*COLOR_ON[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    COLOR_ON = "Koloruj odpowiedzi (^0xff008000ON^-)",~
        REPLACE_TEXTUALLY ~^[ %TAB%]*COLOR_OFF[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    COLOR_OFF = "Koloruj odpowiedzi (^0xff0000ffOFF^-)",~
    BUT_ONLY

