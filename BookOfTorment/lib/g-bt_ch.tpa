// 4) If PST:EE exposes a native Chinese Lua file, localize the same BoT keys there.
    ACTION_IF FILE_EXISTS_IN_GAME ~L_zh_CN.lua~ BEGIN
        COPY_EXISTING ~L_zh_CN.lua~ ~override~
            PATCH_IF (INDEX_BUFFER(~G-Book of Torment~) < 0) BEGIN
                PATCH_IF (INDEX_BUFFER(~^[ %TAB%]*ZOOM_LOCK_LABEL[ %TAB%]*=[ %TAB%]*"[^"]*",~) < 0) BEGIN
                    PATCH_FAIL ~Book of Torment ZS: 未在 L_zh_CN.lua 中找到 ZOOM_LOCK_LABEL；已回滚以避免 UI 不完整。~
                END
                REPLACE_TEXTUALLY ~\(^[ %TAB%]*ZOOM_LOCK_LABEL[ %TAB%]*=[ %TAB%]*"[^"]*",\)~ ~\1

    -- G-Book of Torment (UI mod) - 中文
    ORIGINAL_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n原始\\n^-",
    JPC_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n日志\\t肖像\\t对话\\n\\t（Smeagolheart风格）^-",
    SDB_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n侧边对话框\\n^-",
    TTON_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n仿扭蒙拉对话框\\n^-",
    DBOX_SKIN = "此滑块可更改对话框皮肤。",
    SLIDER_DBOX_STRING_0 = "^0xffd5c885原始",
    SLIDER_DBOX_STRING_1 = "^0xffd5c885展示肖像",
    SLIDER_DBOX_STRING_2 = "^0xffd5c885侧边",
    SLIDER_DBOX_STRING_3 = "^0xffd5c885TTON",
    CLASSIC_INV = "此滑块可更改物品栏皮肤及物品栏位排列。^N\\n\\n经典物品栏\\n^-",
    SHARED_INV = "此滑块可更改物品栏皮肤及物品栏位排列。^N\\n\\n共享物品栏\\n^-",
    INV_SKIN = "此滑块可更改物品栏皮肤及物品栏位排列。",
    SLIDER_INV_STRING_0 = "^0xff78b570经典",
    SLIDER_INV_STRING_1 = "^0xff78b570共享",
    DEFAULT_JOURNAL = "此滑块可更改日志界面。^N\\n\\n默认日志\\n^-",
    NEW_JOURNAL = "此滑块可更改日志界面。^N\\n\\n新版日志\\n^-",
    JOURNAL_SKIN = "此滑块可更改日志界面。",
    SLIDER_JOURNAL_0 = "^0xff7f00ff默认",
    SLIDER_JOURNAL_1 = "^0xff7f00ff新版",
    DIALOGUE_BOX = "对话框：",
    INVENTORY = "物品栏布局：",
    JOURNAL = "日志界面：",
    COLOR_DESC = "为对话框中的已选回答着色并保存（可选与试验性功能）。",
    COLOR_ON = "彩色对话选项（^0xff008000开^-）",
    COLOR_OFF = "彩色对话选项（^0xff0000ff关^-）",~
            END
            REPLACE_TEXTUALLY ~^[ %TAB%]*ORIGINAL_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    ORIGINAL_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n原始\\n^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*JPC_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    JPC_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n日志\\t肖像\\t对话\\n\\t（Smeagolheart风格）^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SDB_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SDB_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n侧边对话框\\n^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*TTON_DBOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    TTON_DBOX = "此滑块可更改对话框皮肤。^N\\n\\n仿扭蒙拉对话框\\n^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*DBOX_SKIN[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    DBOX_SKIN = "此滑块可更改对话框皮肤。",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_0[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_0 = "^0xffd5c885原始",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_1[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_1 = "^0xffd5c885展示肖像",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_2[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_2 = "^0xffd5c885侧边",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_DBOX_STRING_3[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_DBOX_STRING_3 = "^0xffd5c885TTON",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*CLASSIC_INV[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    CLASSIC_INV = "此滑块可更改物品栏皮肤及物品栏位排列。^N\\n\\n经典物品栏\\n^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SHARED_INV[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SHARED_INV = "此滑块可更改物品栏皮肤及物品栏位排列。^N\\n\\n共享物品栏\\n^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*INV_SKIN[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    INV_SKIN = "此滑块可更改物品栏皮肤及物品栏位排列。",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_INV_STRING_0[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_INV_STRING_0 = "^0xff78b570经典",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_INV_STRING_1[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_INV_STRING_1 = "^0xff78b570共享",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*DEFAULT_JOURNAL[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    DEFAULT_JOURNAL = "此滑块可更改日志界面。^N\\n\\n默认日志\\n^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*NEW_JOURNAL[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    NEW_JOURNAL = "此滑块可更改日志界面。^N\\n\\n新版日志\\n^-",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*JOURNAL_SKIN[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    JOURNAL_SKIN = "此滑块可更改日志界面。",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_JOURNAL_0[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_JOURNAL_0 = "^0xff7f00ff默认",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*SLIDER_JOURNAL_1[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    SLIDER_JOURNAL_1 = "^0xff7f00ff新版",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*DIALOGUE_BOX[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    DIALOGUE_BOX = "对话框：",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*INVENTORY[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    INVENTORY = "物品栏布局：",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*JOURNAL[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    JOURNAL = "日志界面：",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*COLOR_DESC[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    COLOR_DESC = "为对话框中的已选回答着色并保存（可选与试验性功能）。",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*COLOR_ON[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    COLOR_ON = "彩色对话选项（^0xff008000开^-）",~
            REPLACE_TEXTUALLY ~^[ %TAB%]*COLOR_OFF[ %TAB%]*=[ %TAB%]*"[^"]*",?~ ~    COLOR_OFF = "彩色对话选项（^0xff0000ff关^-）",~
            BUT_ONLY
    END