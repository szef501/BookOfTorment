BACKUP ~BookOfTorment/backup~
SUPPORT ~FallDamage312 | szef | (https://www.nexusmods.com/planescapetormentenhancededition/mods/9 | https://www.gibberlings3.net/forums/topic/36119-uimodplanescape-ee-book-of-torment-discover-the-dialogues-of-torment-in-a-new-edition/)~
VERSION ~v1.72~

README ~BookOfTorment/readme/readme-%LANGUAGE%.txt~
       ~BookOfTorment/readme/readme.txt~

LANGUAGE ~English~
	~english~
	~BookOfTorment/lang/english/setup.tra~

LANGUAGE ~Polski (Polish)~
	~polish~
	~BookOfTorment/lang/polish/setup.tra~
	
LANGUAGE ~Italiano (Italian)~
	~italian~
	~BookOfTorment/lang/italian/setup.tra~

LANGUAGE ~Simplified Chinese~
    ~schinese~
    ~BookOfTorment/lang/schinese/setup.tra~

BEGIN @01
REQUIRE_PREDICATE (GAME_IS ~pstee~) @02
	
PRINT @10	
	COPY ~%MOD_FOLDER%/copy/main~ ~override~
	COPY ~%MOD_FOLDER%/copy/bam~ ~override~
	COPY ~%MOD_FOLDER%/copy/bestia2~ ~override~
PRINT @11

INCLUDE ~%MOD_FOLDER%/lib/g-bt_ui.tpa~
INCLUDE ~%MOD_FOLDER%/lib/g-bt_it.tpa~
INCLUDE ~%MOD_FOLDER%/lib/g-bt_bestiary_fix.tpa~
INCLUDE ~%MOD_FOLDER%/lib/g-bt.tph~

	
